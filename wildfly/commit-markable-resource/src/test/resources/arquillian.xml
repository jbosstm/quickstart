<?xml version="1.0" encoding="UTF-8"?>

<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
        http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="Servlet 5.0"/>

    <container qualifier="jbossas-managed" default="true">
        <configuration>
            <property name="javaVmArguments">${server.jvm.args} -Djboss.modules.system.pkgs=com.sun.tools.attach,org.jboss.byteman ${xboot.classpath} -javaagent:${byteman.jar}=listener:true,port:9091,prop:org.jboss.byteman.verbose=true</property>
            <property name="serverConfig">standalone-full.xml</property>
            <property name="managementAddress">${node.address}</property>
            <property name="allowConnectingToRunningServer">false</property>
        </configuration>
    </container>

   	<extension qualifier="byteman">
	    <!-- Agents are pre-loaded via -javaagent (see pom.xml surefire argLine and the server javaVmArguments
	         above), so no dynamic attach is performed. The RuleInstallers just submit rules to these ports. -->
	    <property name="autoInstallAgent">false</property>
	    <property name="clientAgentPort">9092</property>
	    <property name="containerAgentPort">9091</property>
	</extension>

	<!--
    <engine>
        <property name="deploymentExportPath">/tmp/deployment</property>
    </engine>
    -->

</arquillian>