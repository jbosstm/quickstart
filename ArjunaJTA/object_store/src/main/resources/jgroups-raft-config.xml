<!--
  JGroups protocol stack for Raft consensus with SHARED_LOOPBACK (local/testing use).

  For production, replace SHARED_LOOPBACK with TCP and SHARED_LOOPBACK_PING with
  TCPPING or JDBC_PING.
-->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">

    <SHARED_LOOPBACK/>
    <org.jgroups.protocols.SHARED_LOOPBACK_PING/>
    <MERGE3 max_interval="30000" min_interval="10000"/>
    <FD_SOCK/>
    <FD_ALL3 timeout="3000" interval="1000"/>
    <VERIFY_SUSPECT timeout="1500"/>
    <BARRIER/>
    <pbcast.NAKACK2 use_mcast_xmit="false"
                    discard_delivered_msgs="true"
                    log_discard_msgs="false"
                    log_not_found_msgs="false"/>
    <UNICAST3 conn_expiry_timeout="0"/>
    <pbcast.STABLE desired_avg_gossip="50000" max_bytes="8M"/>
    <raft.NO_DUPES/>
    <pbcast.GMS print_local_addr="true" join_timeout="3000"/>
    <UFC max_credits="2M" min_threshold="0.4"/>
    <MFC max_credits="2M" min_threshold="0.4"/>
    <FRAG4 frag_size="60K"/>
    <raft.ELECTION/>
    <raft.RAFT/>
    <raft.REDIRECT/>
</config>
